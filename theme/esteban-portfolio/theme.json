{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#0b1120"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#111a2e"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#1e293b"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#e2e8f0"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#94a3b8"
				},
				{
					"slug": "accent",
					"name": "Accent (sky)",
					"color": "#38bdf8"
				},
				{
					"slug": "accent-2",
					"name": "Accent 2 (emerald)",
					"color": "#34d399"
				}
			],
			"gradients": [
				{
					"slug": "sky-emerald",
					"name": "Sky to emerald",
					"gradient": "linear-gradient(90deg, #38bdf8 0%, #34d399 100%)"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "system",
					"name": "Geist",
					"fontFamily": "Geist, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Geist",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/geist-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Geist Mono",
					"fontFamily": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "Geist Mono",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/geist-mono-latin-wght-normal.woff2"
							]
						}
					]
				}
			],
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.05rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3.5rem",
					"fluid": {
						"min": "2.4rem",
						"max": "3.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "2.5rem"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "4rem"
				},
				{
					"slug": "70",
					"name": "XXL",
					"size": "6rem"
				}
			]
		},
		"custom": {
			"logo": {
				"chipBackground": "#ffffff",
				"chipText": "#0f172a",
				"bracket": "#0284c7",
				"caret": "#10b981"
			},
			"radius": {
				"card": "14px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.025em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#0b1120"
				},
				"border": {
					"radius": "10px"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			},
			"core/group": {
				"variations": {
					"card": {
						"color": {
							"background": "var(--wp--preset--color--surface)"
						},
						"border": {
							"radius": "var(--wp--custom--radius--card)",
							"width": "1px",
							"style": "solid",
							"color": "var(--wp--preset--color--border)"
						},
						"spacing": {
							"padding": {
								"top": "var(--wp--preset--spacing--40)",
								"bottom": "var(--wp--preset--spacing--40)",
								"left": "var(--wp--preset--spacing--40)",
								"right": "var(--wp--preset--spacing--40)"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [],
	"patterns": []
}