{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1120px" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#0b0d12" },
				{ "slug": "surface", "name": "Surface", "color": "#151922" },
				{ "slug": "border", "name": "Border", "color": "#262c38" },
				{ "slug": "contrast", "name": "Contrast", "color": "#e8eaf0" },
				{ "slug": "muted", "name": "Muted", "color": "#9aa3b2" },
				{ "slug": "accent", "name": "Accent", "color": "#6b95ff" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System Sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.05rem" },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.5rem", "fluid": { "min": "2.4rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "2.5rem" },
				{ "slug": "60", "name": "XL", "size": "4rem" },
				{ "slug": "70", "name": "XXL", "size": "6rem" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"heading": { "typography": { "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.02em" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "8px" },
				"typography": { "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--small)" },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)" } }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--medium)" }, "elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" } } } },
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } },
			"core/post-terms": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--small)" } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--border)" } },
			"core/group": {
				"variations": {
					"card": {
						"color": { "background": "var(--wp--preset--color--surface)" },
						"border": { "radius": "12px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--border)" },
						"spacing": { "padding": { "top": "var(--wp--preset--spacing--40)", "bottom": "var(--wp--preset--spacing--40)", "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" } }
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [],
	"patterns": []
}
